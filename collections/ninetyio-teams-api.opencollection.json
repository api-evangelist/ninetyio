{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ninety Public Issues Teams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/teams"
          },
          "docs": "Returns all Teams the authenticated user belongs to."
        }
      ]
    }
  ],
  "bundled": true
}