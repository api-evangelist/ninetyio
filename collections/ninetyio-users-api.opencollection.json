{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ninety Public Issues Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a User by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The User Id"
              }
            ]
          },
          "docs": "Returns a single User by their Id. The authenticated user must have Read-level permissions."
        }
      ]
    }
  ],
  "bundled": true
}